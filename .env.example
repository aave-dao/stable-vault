ALCHEMY_KEY=

# Optional local fork deployment addresses. run-adi-pigeon-fork-test.sh
# exports these from adi-deploy/deployments/stable-vaults/*.json automatically.
# STABLE_VAULTS_OWNER=0xfB65C68526969DA4AA3cEDF30b1C53846116D5a2
# ETH_CCC=0x33E3B9D276f58A873e9Acc9f25A8a46F5b66F259
# ARB_CCC=0x98cF75814a129845EA7d69dbD0B6923A6Dac0c6b
# ETH_ARB_ADAPTER=0xC9B2A285B62c0eD494C3C23FAc7C169EaE740C59
# ETH_CCIP_ADAPTER=
# ETH_LZ_ADAPTER=
# ETH_HL_ADAPTER=
# ARB_CCIP_ADAPTER=
# ARB_LZ_ADAPTER=
# ARB_HL_ADAPTER=

# Optional wrapper script settings.
# ADI_DEPLOY_DIR=.local/adi-deploy-forktest
# ADI_DEPLOY_PR=2
# ADI_DEPLOY_REF=pull/2/head
# ENV_FILE=.env
# RUN_ADI_DEPLOY=true
# RESTART_ANVIL=true

# ---------------------------------------------------------------------------
# Smoke-harness RPC URLs (tools/smoke). One per (env, network) pair, where
# `network` is the lowercase label in tools/smoke/networks.json (arbitrum,
# ethereum, …). Convention: SMOKE_RPC_<ENV>_<NETWORK_UPPER>. Add a new entry
# when networks.json gains another chain. Staging uses Tenderly vnet URLs;
# preprod and prod use real mainnet RPCs.
# ---------------------------------------------------------------------------

# Staging — Tenderly vnet RPCs (paste from the vnet you spun up for the deploy)
SMOKE_RPC_STAGING_ARBITRUM=
SMOKE_RPC_STAGING_ETHEREUM=

# Preprod — mainnet RPCs (Alchemy / Infura / your provider of choice)
SMOKE_RPC_PREPROD_ARBITRUM=
SMOKE_RPC_PREPROD_ETHEREUM=

# Prod — mainnet RPCs. Same providers as preprod are fine; separate vars so
# you can point them at different keys if you want stricter isolation.
SMOKE_RPC_PROD_ARBITRUM=
SMOKE_RPC_PROD_ETHEREUM=
